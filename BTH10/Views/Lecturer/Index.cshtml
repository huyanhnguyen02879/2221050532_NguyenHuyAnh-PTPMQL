@model IEnumerable<BTH7.Models.Lecturer>

@{
    ViewData["Title"] = "Giảng viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Danh sách giảng viên</h1>
    <button type="button"
            class="btn btn-primary js-open-lecturer-modal"
            data-url="@Url.Action("Create", "Lecturer")">
        Thêm giảng viên
    </button>
</div>

<div id="lecturer-list-error" class="alert alert-danger d-none" role="alert"></div>

<form id="lecturer-search-form" class="row g-2 mb-3" asp-action="Index" method="get">
    <div class="col-sm-8 col-md-6">
        <label class="visually-hidden" for="lecturer-search">Tìm giảng viên</label>
        <input id="lecturer-search"
               name="searchTerm"
               value="@ViewData["SearchTerm"]"
               class="form-control"
               placeholder="Tìm theo họ tên, email hoặc số điện thoại..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <button type="button" id="lecturer-search-clear" class="btn btn-outline-secondary">Xóa</button>
    </div>
</form>

<div id="lecturer-table-container">
    <partial name="_LecturerTable" model="Model" />
</div>

<div class="modal fade" id="lecturer-modal" tabindex="-1" aria-labelledby="lecturer-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="lecturer-modal-content"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ajaxCrud.js" asp-append-version="true"></script>
    <script src="~/js/lecturer.js" asp-append-version="true"></script>
}

@model bool

@{
    ViewData["Title"] = "Kết quả đặt lại mật khẩu";
}

<div class="alert @(Model ? "alert-success" : "alert-info")">
    @if (Model)
    {
        <p class="mb-0">Mật khẩu đã được cập nhật. <a asp-action="Login">Đăng nhập</a>.</p>
    }
    else
    {
        <p class="mb-0">Nếu tài khoản tồn tại, yêu cầu đã được xử lý. Nếu cần, hãy yêu cầu đặt lại mật khẩu mới.</p>
    }
</div>

@model IEnumerable<BTH7.Models.Faculty>

@{
    ViewData["Title"] = "Khoa";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Danh sách khoa</h1>
    <button type="button"
            class="btn btn-primary js-open-faculty-modal"
            data-url="@Url.Action("Create", "Faculty")">
        Thêm khoa
    </button>
</div>

<div id="faculty-list-error" class="alert alert-danger d-none" role="alert"></div>

<form id="faculty-search-form" class="row g-2 mb-3" asp-action="Index" method="get">
    <div class="col-sm-8 col-md-6">
        <label class="visually-hidden" for="faculty-search">Tìm khoa</label>
        <input id="faculty-search"
               name="searchTerm"
               value="@ViewData["SearchTerm"]"
               class="form-control"
               placeholder="Tìm theo mã hoặc tên khoa..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <button type="button" id="faculty-search-clear" class="btn btn-outline-secondary">Xóa</button>
    </div>
</form>

<div id="faculty-table-container">
    <partial name="_FacultyTable" model="Model" />
</div>

<div class="modal fade" id="faculty-modal" tabindex="-1" aria-labelledby="faculty-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="faculty-modal-content"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ajaxCrud.js" asp-append-version="true"></script>
    <script src="~/js/faculty.js" asp-append-version="true"></script>
}

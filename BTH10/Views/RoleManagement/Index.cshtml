@model BTH7.Models.RoleListViewModel

@{
    ViewData["Title"] = "Quản lý Role";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Danh sách Role</h1>
    <button type="button"
            class="btn btn-primary js-open-role-modal"
            data-url="@Url.Action("Create", "RoleManagement")">
        Thêm Role
    </button>
</div>

<div id="role-list-error" class="alert alert-danger d-none" role="alert"></div>

<form id="role-search-form" class="row g-2 mb-3" asp-action="Index" method="get">
    <div class="col-sm-8 col-md-6">
        <label class="visually-hidden" for="role-search">Tìm Role</label>
        <input id="role-search"
               name="searchTerm"
               value="@ViewData["SearchTerm"]"
               class="form-control"
               placeholder="Tìm theo tên Role..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <button type="button" id="role-search-clear" class="btn btn-outline-secondary">Xóa</button>
    </div>
</form>

<div id="role-table-container">
    <partial name="_RoleTable" model="Model.Roles" />
</div>

<div class="modal fade" id="role-modal" tabindex="-1" aria-labelledby="role-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="role-modal-content"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ajaxCrud.js" asp-append-version="true"></script>
    <script src="~/js/role.js" asp-append-version="true"></script>
}

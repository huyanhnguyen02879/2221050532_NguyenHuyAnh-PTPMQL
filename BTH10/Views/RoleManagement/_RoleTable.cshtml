@model IEnumerable<BTH7.Models.RoleViewModel>

@{
    var currentPageIndex = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
}

<div data-current-page="@currentPageIndex">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Tên Role</th>
                    <th>Số người dùng</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var role in Model)
                    {
                        var isAdministrator = string.Equals(role.Name, BTH7.Models.AppRoles.Administrator, StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td>@role.Name</td>
                            <td>@role.UserCount</td>
                            <td class="text-end text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-outline-info js-open-role-modal"
                                        data-url="@Url.Action("Details", "RoleManagement", new { id = role.Id })">
                                    Chi tiết
                                </button>
                                @if (!isAdministrator)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary js-open-role-modal"
                                            data-url="@Url.Action("Edit", "RoleManagement", new { id = role.Id })">
                                        Sửa
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger js-open-role-modal"
                                            data-url="@Url.Action("Delete", "RoleManagement", new { id = role.Id })">
                                        Xóa
                                    </button>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Role hệ thống</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            Không tìm thấy Role phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Phân trang Role">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPageIndex <= 1 ? "disabled" : "")">
                    <button type="button"
                            class="page-link js-role-page"
                            data-page="@(currentPageIndex - 1)"
                            aria-label="Trang trước"
                            disabled="@(currentPageIndex <= 1)">
                        Trước
                    </button>
                </li>
                @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == currentPageIndex ? "active" : "")">
                        <button type="button"
                                class="page-link js-role-page"
                                data-page="@pageNumber"
                                aria-current="@(pageNumber == currentPageIndex ? "page" : null)">
                            @pageNumber
                        </button>
                    </li>
                }
                <li class="page-item @(currentPageIndex >= totalPages ? "disabled" : "")">
                    <button type="button"
                            class="page-link js-role-page"
                            data-page="@(currentPageIndex + 1)"
                            aria-label="Trang sau"
                            disabled="@(currentPageIndex >= totalPages)">
                        Sau
                    </button>
                </li>
            </ul>
        </nav>
    }
</div>

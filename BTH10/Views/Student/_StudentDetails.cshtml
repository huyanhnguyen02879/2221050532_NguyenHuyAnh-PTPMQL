@model BTH7.Models.Student

<div class="modal-header">
    <h2 class="modal-title fs-5" id="student-modal-title">Chi tiết sinh viên</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>
<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Mã sinh viên</dt>
        <dd class="col-sm-9">@Model.StudentCode</dd>
        <dt class="col-sm-3">Họ tên</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Khoa</dt>
        <dd class="col-sm-9">
            @if (Model.Faculty != null)
            {
                @($"{Model.Faculty.FacultyCode} - {Model.Faculty.FacultyName}")
            }
        </dd>
    </dl>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
</div>
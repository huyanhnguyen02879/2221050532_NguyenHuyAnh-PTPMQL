@model IEnumerable<BTH7.Models.Student>

@{
    ViewData["Title"] = "Sinh viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Danh sách sinh viên</h1>
    <button type="button"
            class="btn btn-primary js-open-student-modal"
            data-url="@Url.Action("Create", "Student")">
        Thêm sinh viên
    </button>
</div>

<div id="student-list-error" class="alert alert-danger d-none" role="alert"></div>

<form id="student-search-form" class="row g-2 mb-3" asp-action="Index" method="get">
    <div class="col-sm-8 col-md-6">
        <label class="visually-hidden" for="student-search">Tìm sinh viên</label>
        <input id="student-search"
               name="searchTerm"
               value="@ViewData["SearchTerm"]"
               class="form-control"
               placeholder="Tìm theo mã, tên, email hoặc khoa..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <button type="button" id="student-search-clear" class="btn btn-outline-secondary">Xóa</button>
    </div>
</form>

<div id="student-table-container">
    <partial name="_StudentTable" model="Model" />
</div>

<div class="modal fade" id="student-modal" tabindex="-1" aria-labelledby="student-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="student-modal-content"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ajaxCrud.js" asp-append-version="true"></script>
    <script src="~/js/student.js" asp-append-version="true"></script>
}
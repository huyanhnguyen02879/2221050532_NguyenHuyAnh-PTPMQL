@{
    ViewData["Title"] = "Thêm sinh viên";
}


<div class="container student-container">

    <h2 class="student-title">
        @ViewData["Title"]
    </h2>


    <form asp-action="Create" method="post">


        <div class="mb-3">

            <label class="form-label">
                Họ tên
            </label>

            <input name="Name"
                   class="form-control" />

        </div>



        <div class="mb-3">

            <label class="form-label">
                Địa chỉ
            </label>

            <input name="Address"
                   class="form-control" />

        </div>



        <div class="mb-3">

            <label class="form-label">
                Trường
            </label>

            <input name="University"
                   class="form-control" />

        </div>



        <button type="submit"
                class="btn btn-primary btn-add">

            Thêm sinh viên

        </button>


    </form>

</div>
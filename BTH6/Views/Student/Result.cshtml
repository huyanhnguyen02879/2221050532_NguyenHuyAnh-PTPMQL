<div class="container student-container">


<h2 class="student-title">
    @ViewData["Title"]
</h2>


@if(TempData["Success"] != null)
{
    <div class="alert alert-success">

        @TempData["Success"]

    </div>
}



<div class="card">

    <div class="card-header">
        Thông tin sinh viên
    </div>


    <div class="card-body">


        <p>
            <b>Họ tên:</b>
            @ViewBag.Student.Name
        </p>


        <p>
            <b>Địa chỉ:</b>
            @ViewBag.Student.Address
        </p>


        <p>
            <b>Trường:</b>
            @ViewBag.Student.University
        </p>


    </div>

</div>


</div>